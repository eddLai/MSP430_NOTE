# Ignore Obsidian cache files
.obsidian/cache/*

# Ignore Obsidian workspace files (local UI state — causes merge conflicts)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspace

# Ignore any backup files
*.bak

# Ignore any temporary files
*~

# Ignore macOS specific files
.DS_Store

# Ignore Windows thumbnail files
Thumbs.db
